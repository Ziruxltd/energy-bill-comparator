# Copy to .env for `pnpm dev` / `pnpm evals`. Never commit real values.
ANTHROPIC_API_KEY=
# Optional: defaults live in packages/extraction/src/config.ts
ANTHROPIC_MODEL_DETECTION=claude-haiku-5-5
ANTHROPIC_MODEL_EXTRACTION=claude-sonnet-5-5
# "true" serves pre-extracted samples and never calls Claude
DEMO_MODE=false
